<Project>
  <PropertyGroup>
    <!-- The SDK's public canonical-runtime switch propagates as a global
         property to referenced projects. Normalize it here, during props
         evaluation, before NuGet constructs the transitive restore graph. -->
    <LibreWinFormsUseProGpuSystemDrawing
      Condition="'$(LibreWinFormsUseCanonicalRuntime)' == 'true'">true</LibreWinFormsUseProGpuSystemDrawing>
    <!--
      Source-first development uses the repository-owned ProGPU submodule. Consumers
      continue to use LibreWinFormsReferenceMode=Package unless they opt into Project.
      The sibling fallback keeps existing LibreWPF superproject checkouts working while
      they move to the explicit source-root property.
    -->
    <LibreWinFormsProGpuSourceRoot
      Condition="'$(LibreWinFormsProGpuSourceRoot)' == '' And Exists('$(MSBuildThisFileDirectory)..\external\ProGPU\src\ProGPU.Backend\ProGPU.Backend.csproj')">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\external\ProGPU'))</LibreWinFormsProGpuSourceRoot>
    <LibreWinFormsProGpuSourceRoot
      Condition="'$(LibreWinFormsProGpuSourceRoot)' == '' And Exists('$(MSBuildThisFileDirectory)..\..\ProGPU\src\ProGPU.Backend\ProGPU.Backend.csproj')">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..\ProGPU'))</LibreWinFormsProGpuSourceRoot>
    <LibreWinFormsDrawingRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\src\ProGPU.Drawing'))</LibreWinFormsDrawingRoot>
  </PropertyGroup>
</Project>
